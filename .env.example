# Vercel API base URL (no trailing slash)
# Production example:
VITE_API_BASE_URL=https://novasafe-blog-writing-api.vercel.app/api/v1

# Local dev (Cloudflare Worker / Vercel dev)
# VITE_API_BASE_URL=http://localhost:3000/api/v1

# Optional: pre-set admin JWT (or sign in via Settings)
# VITE_API_TOKEN=

# Public blog SEO
VITE_SITE_URL=https://novasafe.io
VITE_SITE_NAME=NovaSafe Blog
VITE_SITE_DESCRIPTION=Security insights and updates from the NovaSafe team.
# VITE_DEFAULT_OG_IMAGE=https://novasafe.io/og-default.png
# VITE_TWITTER_HANDLE=@novasafe
